      "actions": [
        { "type": "click", "selector": "a.nav-link[href=\"#replay\"]" },
        { "type": "waitFor", "selector": "a.nav-link[href=\"#replay\"].active" }
      ],
      "settleMs": 1200
    },
    {
      "id": "organization",
