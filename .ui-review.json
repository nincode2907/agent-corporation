{
  "version": 1,
  "project": "Agent Corporation",
  "baseUrl": "http://127.0.0.1:15500",
  "outputDir": "artifacts/ui-review",
  "viewports": {
    "desktop": { "width": 1440, "height": 900 },
    "mobile": { "width": 390, "height": 844 }
  },
  "targets": [
    {
      "id": "overview",
      "name": "Tổng quan",
      "route": "/",
      "viewports": ["desktop", "mobile"],
      "settleMs": 1200,
      "pdf": true
    },
    {
      "id": "playground",
      "name": "Development Playground",
      "route": "/",
      "viewports": ["desktop", "mobile"],
      "actions": [
        { "type": "click", "selector": "a.nav-link[href=\"#playground\"]" },
        { "type": "waitFor", "selector": "a.nav-link[href=\"#playground\"].active" }
      ],
      "settleMs": 1200,
      "pdf": true
    },
    {
      "id": "office",
      "name": "Văn phòng trực tiếp",
